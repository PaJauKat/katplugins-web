# ============================================================
# Backend Go (api/) — NUNCA exponer estas en el navegador
# ============================================================

# Base de datos (Supabase solo como Postgres; no se usa Supabase Auth)
SUPABASE_URL=https://odjbgghglknikndzkqgx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID -> Web)
# Authorized redirect URI: <APP_BASE_URL>/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# URL publica base (define el redirect_uri y el post-login)
# Produccion: https://katplugins.pajau.cl   Local: http://localhost:3000
APP_BASE_URL=https://katplugins.pajau.cl

# Secreto para firmar la cookie de sesion (cadena aleatoria larga)
# Genera uno con:  powershell -c "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
SESSION_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Base URL de los jars de plugins en R2 (para /api/entitlements y /api/manifest)
PLUGINS_BASE_URL=https://bucket.pajau.cl

# Token para que el build de KatPlugins sincronice el catalogo (POST /api/admin/plugins/sync)
SYNC_TOKEN=cambia-esto-por-un-secreto

# Correos que SIEMPRE son admin (separados por coma). Opcional.
ADMIN_EMAILS=tu-correo@gmail.com

# Origenes extra permitidos para CORS (separados por coma). Opcional.
ALLOWED_ORIGINS=

# ============================================================
# Frontend (web/) — no necesita variables: la sesion viaja en
# una cookie httpOnly y todas las llamadas van a /api (backend Go).
# ============================================================
